{
  // Project name (must match your Cloudflare Pages project name)
  "name": "movies-shop",

  // Build configuration for your Angular project
  "build": {
    // Command to build your Angular project
    "command": "npm run build:prod",

    // Directory where the built files are located
    "directory": "dist/movies_shop_angular"
  },

  // Compatibility date for Workers (optional, if using Workers)
  "compatibility_date": "2023-10-01",

  // Optional: Routes for Workers or Pages integration
  "routes": [
    // Example route for integrating with a Worker
    // "example.com/*"
  ],

  // Optional: Environment-specific configurations
  "env": {
    "production": {
      // Production-specific environment variables
      "vars": {
        "API_URL": "https://api.example.com",
        "NODE_ENV": "production"
      }
    },
    "staging": {
      // Staging-specific environment variables
      "vars": {
        "API_URL": "https://staging-api.example.com",
        "NODE_ENV": "staging"
      }
    }
  }
}
